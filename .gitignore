# companion de brainstorm do superpowers: rascunho de sessao, nao e
# conteudo do repositorio. O que vale de um brainstorm vira spec em
# docs/superpowers/specs/.
/.claude/
/.claude/*/.venv/
.superpowers/

# python
__pycache__/
*.py[cod]
.venv/
venv/
/.venv/
.venv

# front: dependencias e build saem do Vite
web/node_modules/
web/dist/

# playwright
web/e2e/.tmp/
web/test-results/
web/playwright-report/

# macOS
.DS_Store

# saida gerada: derivada do tenant, nao e fonte. As duas formas entram, e
# nenhuma cobre a outra: out/*/ e a pasta de cada ASN, e out/*.txt e o bloco
# que a migracao DEIXA na raiz do out/ quando o destino ja tem o arquivo com
# o mesmo nome (o _mover_saida, em app/tenants.py, nao sobrescreve o que ja
# estava la). Sem elas os blocos de producao aparecem como nao rastreados e
# entram num `git add .`
out/*/
out/*.txt
out/.cache/

# o cadastro de cada rede. A barra da frente ancora a regra na pasta da
# raiz: um `peers/` solto casaria tambem com a web/src/telas/peers/ dos
# componentes de peer, e um arquivo novo la nasceria ignorado
/peers/
peers.yaml.bak

# excecao que hoje nao pega nada, e que fica de proposito: quem protege a
# fixture do e2e e a ancora da regra /peers/ acima, que nunca casou com este
# caminho. O seguro e para quem um dia tirar a barra da frente e soltar a
# regra, que ai passaria a casar com web/src/telas/peers/ e com este
!web/e2e/peers/

# o cadastro de antes da pasta dos tenants: quem migra e o boot, e o .bak
# fica para tras
peers.yaml

# o login: hash da senha e o segredo que assina o cookie. O arquivo nasce
# no primeiro boot do app, e nao vem do repositorio
usuarios.yaml

# config real do equipamento: fica no disco, nao no repositorio
BGP_EXEMPLO.txt

# grafo derivado do codigo e do config acima, refaz com o graphify
graphify-out/
compose.yaml

bagulhos/