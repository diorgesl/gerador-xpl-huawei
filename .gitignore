# docs/superpowers/specs/.
/.claude/
/.claude/*/.venv/
.superpowers/

# cache do bgpq4: derivado do IRR, refaz com o botao de atualizar
out/.cache/

# python
__pycache__/
*.py[cod]
.venv/
venv/
/.venv/
.venv

# front: dependencias e build saem do Vite
web/node_modules/
web/dist/

# playwright
web/e2e/.tmp/
web/test-results/
web/playwright-report/

# macOS
.DS_Store

# saida gerada: derivada do peers.yaml, nao e fonte
out/*.txt

peers.yaml

# excecao: o cadastro do e2e e fixture do repositorio; o peers.yaml
# ignorado acima e o do equipamento
!web/e2e/peers.yaml

# config real do equipamento: fica no disco, nao no repositorio
BGP_EXEMPLO.txt

