{% macro cabecalho(peer, grupo=none, origem=none) -%}
# gerado por bgpgen - nao editar a mao
# peer {{ peer.id }} - {{ peer.tipo }} - AS{{ peer.asn }} - token {{ peer.token }}
{# A tabela que vale e a de quem define o export: o grupo, no membro, porque
   o export do membro termina chamando o do grupo; a origem, em quem
   reaproveita, porque o bloco dele chama os filtros dela. O valor gravado no
   proprio peer nesses dois casos nao chega a filtro nenhum. #}
{% if peer.tipo in plan.TIPOS_DOWNSTREAM %}
{% if origem is not none %}
# tabela recebida: {{ origem.tabela }} (a do peer {{ origem.token }}, de quem a politica vem)
{% elif grupo %}
# tabela recebida: {{ grupo.tabela }} (a do grupo {{ grupo.nome }})
{% else %}
# tabela recebida: {{ peer.tabela }}
{% endif %}
{% endif %}
{# o aviso da default route nao cabe no bloco bgp: nenhum tipo tem comentario
   renderizado dentro do grupo de sessao nem da familia. Ele fica aqui, que e
   o que o operador le antes de colar. O VRP origina a default nesta sessao
   mesmo sem default na RIB, e por fora do route-filter de export
   (confirmado no equipamento). #}
{% if grupo and peer.politica_de is none %}
{% if grupo.default_route %}
# default route: a do grupo {{ grupo.nome }}; o VRP origina 0/0 e ::/0 mesmo sem default na tabela
{% endif %}
{% elif peer.default_route %}
# default route: o VRP origina 0/0 e ::/0 nesta sessao mesmo sem default na tabela
{% endif %}
# pressupoe o bloco base ja aplicado neste equipamento
{%- endmacro %}

{# O filtro que aplica a CL-PEER-<T> no import. Ele sai em dois lugares, o
   bloco do peer e o quadro "ao criar o peer", e os dois precisam sair
   identicos: o segundo a ser colado sobrescreve o primeiro. Por isso mora
   aqui, e nao copiado em cada template. #}
{% macro apply_peer(peer) -%}
xpl route-filter APPLY-PEER-{{ peer.token }}
{# Em XPL o nome da lista entra direto: "apply community <lista>". O
   "community-list" do meio, que o legado usa em route-policy, NAO existe
   aqui - confirmado no equipamento, e o pior tipo de erro: a linha e aceita,
   porque o VRP le o token como se fosse uma community, e a lista nunca e
   aplicada. A mesma coisa vale para o "large-community-list" da linha de
   large-community. #}
 apply community CL-PEER-{{ peer.token }} additive
{% if peer.large_communities %}
 apply large-community LC-PEER-{{ peer.token }} additive
{% endif %}
 break
end-filter
{%- endmacro %}

{% macro sessao_do_peer(peer, fam) -%}
{% set s = peer.sessoes[fam] %}
 peer {{ s.remoto }} as-number {{ peer.asn }}
{# a descricao e texto livre no cadastro, e pode estar em branco: sem ela o
   comando nao sai, porque `peer X description` sem argumento e linha
   incompleta de CLI. Os ramos de membro dos quatro templates de tipo
   repetem esta guarda. #}
{% if peer.descricao %}
 peer {{ s.remoto }} description {{ peer.descricao }}
{% endif %}
{# route-limit e public-as-only nao saem aqui: os dois sao da familia no VRP,
   e ficam no familia_bgp. O multihop e da sessao; o TTL e fixo
   (plan.MULTIHOP_TTL), o cadastro so diz se a sessao e multihop. Os ramos de
   membro dos quatro templates de tipo repetem esta linha: o grupo nao a
   carrega. #}
{% if peer.multihop %}
 peer {{ s.remoto }} ebgp-max-hop {{ plan.MULTIHOP_TTL }}
{% endif %}
{% if peer.tipo == "ix" %}
{# motivo: o route server e transparente e nao insere o proprio ASN no path,
   entao o ASN na frente do path e o de quem anunciou, nao o do vizinho, e o
   check no default descarta a rota antes de ela alcancar o filtro. O undo
   abre o path vazio, que fica a cargo do AP-LOCAL-ORIGIN do IMPORT-SANITY.
   O comentario e do Jinja e nao uma linha !- de proposito: o grupo de sessao
   nao tem comentario renderizado em tipo nenhum. #}
 undo peer {{ s.remoto }} check-first-as enable
{% endif %}
{% if peer.timer_keepalive and peer.timer_hold %}
 peer {{ s.remoto }} timer keepalive {{ peer.timer_keepalive }} hold {{ peer.timer_hold }}
{% endif %}
{% if peer.graceful_restart %}
 peer {{ s.remoto }} capability-advertise graceful-restart
{% endif %}
{% if peer.bfd %}
 peer {{ s.remoto }} bfd enable
{% endif %}
{%- endmacro %}

{% macro familia_bgp(peer, fam, import_nome, export_nome) -%}
{% set s = peer.sessoes[fam] %}
{# A default route sai pelo comando, sem ramo nenhum no export: quem quiser
   bloquea-la do lado dele. A quebra vai dentro do valor porque o Jinja come a
   quebra que segue um bloco, e o {%- do endmacro cola na ultima linha: com um
   {% if %} solto, o peer sem a flag terminava com uma linha em branco. #}
{% set linha_default = "\n  peer " ~ s.remoto ~ " default-route-advertise" if peer.default_route else "" %}

 {{ "ipv6-family" if fam == "v6" else "ipv4-family" }} unicast
  peer {{ s.remoto }} enable
  peer {{ s.remoto }} route-limit {{ peer.route_limit }} {{ plan.ACAO_LIMITE }}
  peer {{ s.remoto }} {{ plan.AS_ONLY }}
  peer {{ s.remoto }} route-filter {{ import_nome }} import
  peer {{ s.remoto }} route-filter {{ export_nome }} export
  peer {{ s.remoto }} advertise-community
  peer {{ s.remoto }} advertise-large-community{{ linha_default }}
{%- endmacro %}

{# Sem guarda em alvo.cidrs(fam): o header/end-list saem sempre, mesmo
   com a lista de cidr vazia, porque e assim que o template original e o
   undo em remover.txt.j2 (sem guarda tambem) sempre se comportaram - um
   guard aqui tiraria da simetria criado/derrubado no peer dual-stack com
   uma familia sem prefixo (ver test_o_bloco_de_remocao_derruba_...). #}
{% macro prefix_lists_downstream(alvo, fam) -%}
{% set U = fam|upper %}
{% set kw = "ipv6-prefix-list" if fam == "v6" else "ip-prefix-list" %}
{% set hostlen = 128 if fam == "v6" else 32 %}
{#- a entrada segue o alcance da linha: exata sem sufixo, com `le` quando a
    linha escreve o intervalo. O grupo chega aqui com o teto no lugar do
    alcance, e por isso a lista dele nao muda.
    As duas listas saem das mesmas linhas, cada uma sem o que a outra ja
    alcanca: o /23 que so carrega um tratamento nao repete o que o /22
    mais largo ja alcanca. #}
{% set confinamento = plan.linhas_do_confinamento(alvo.cidrs(fam)) %}
{% set blackhole = plan.linhas_do_blackhole(alvo.cidrs(fam)) %}
xpl {{ kw }} PL-CUST-{{ alvo.token }}-{{ U }}
{% for prefixo, ate in confinamento %}
 {{ plan.entrada_do_prefixo(prefixo, ate) }}{{ "," if not loop.last }}
{% endfor %}
end-list

xpl {{ kw }} PL-CUST-{{ alvo.token }}-BH-{{ U }}
{% for prefixo, ate in blackhole %}
 {{ plan.cidr_para_xpl(prefixo) }} ge {{ hostlen }} le {{ hostlen }}{{ "," if not loop.last }}
{% endfor %}
end-list

{% endmacro %}

{# Os "{% if alvo.asn %}" deste macro e dos dois seguintes
   (filtro_downstream_import e filtro_downstream_export) sao intencionais,
   nao um guard novo que precisa virar parametro do jeito que
   confinar_prefixo virou. O Peer que chega aqui sempre tem asn truthy:
   app/validate.py trava ASN_MIN=1, entao alvo.asn=0/None so acontece
   construindo Peer(...) direto, pulando a validacao (e o que um teste faz
   de proposito, ver test_filtro_com_asn_falsy_pula_confinamento_por_as_path
   em tests/test_render.py). O unico chamador legitimo onde alvo.asn e
   falsy de verdade e o GRUPO (task 5), que pode nao ter ASN compartilhado
   (grupo de parceiros com ASNs distintos) - pular o confinamento por
   as-path, a linha de large-community enderecada ao ASN e o
   AP-CUST-<token> e o comportamento certo pra ele, nao um workaround. Os
   dois chamadores legitimos (Peer e Grupo) querem o mesmo do guard, entao
   nao precisa de parametro explicito: seria over-engineering pra um caso
   que nao e ambiguo. #}
{% macro ap_cust_downstream(alvo) -%}
{% if alvo.asn %}
xpl as-path-list AP-CUST-{{ alvo.token }}
 origin '{{ alvo.asn }}'
end-list
{% endif -%}
{%- endmacro %}

{# chamar_apply_peer=true: o caller de sempre, cliente/parceiro avulso e
   membro de grupo com filtro proprio, ambos tem CL-PEER-<token> deles
   mesmos. chamar_apply_peer=false: o filtro do grupo de cliente/parceiro
   (grupo_cliente.txt.j2), que nao tem CL-PEER proprio - isso e por sessao,
   nao por grupo (ver spec).

   confinar_prefixo=true: peer avulso (Peer) - o comportamento original,
   sempre confina ao PL-CUST e testa blackhole, mesmo com prefixos[fam]
   vazio (um cliente dual-stack sem prefixo v6 autorizado tem que RECUSAR
   tudo em v6, nao aceitar por falta de guarda). confinar_prefixo=false:
   reservado para o GRUPO (task 5), onde prefixos[fam] vazio significa "sem
   confinamento compartilhado", nao "recuse tudo" - por isso o sinal tem
   que vir explicito do caller, nao inferido de alvo.prefixos[fam]. #}
{% macro filtro_downstream_import(alvo, fam, chamar_apply_peer, confinar_prefixo) -%}
{% set U = fam|upper %}
{% set nexthop = "100::" if fam == "v6" else "192.0.2.1" %}
{% set tratamentos = alvo.tratamentos(fam) %}
xpl route-filter CUST-{{ alvo.token }}-IMPORT-{{ U }}
 call route-filter IMPORT-SANITY-{{ U }}
{% if confinar_prefixo %}
 if (community matches-any CL-BLACKHOLE or tag eq 666) and {{ "ipv6" if fam == "v6" else "ip" }} route-destination in PL-CUST-{{ alvo.token }}-BH-{{ U }} then
  apply {{ "ipv6" if fam == "v6" else "ip" }} next-hop {{ nexthop }}
  apply local-preference {{ plan.LP_BLACKHOLE }}
  apply community {{ plan.conjunto(plan.BLACKHOLE_INFO, plan.c(200)) }} additive
  apply large-community {{ plan.conjunto(plan.c_large(1000, alvo.asn)) }} additive
  finish
 endif
 {# o pedido de descarte que nao casou o ramo de cima e de prefixo maior que
     o host, ou fora do bloco: sem este veto ele caia na whitelist normal, e o
     additive levava o 65535:666 para upstream e IX pedindo o descarte do
     bloco inteiro, sem o 667. #}
 if community matches-any CL-BLACKHOLE or tag eq 666 then
  refuse
 endif
 if not {{ "ipv6" if fam == "v6" else "ip" }} route-destination in PL-CUST-{{ alvo.token }}-{{ U }} then
  refuse
 endif
{% endif %}
{% if alvo.asn %}
 if not as-path in AP-CUST-{{ alvo.token }} then
  refuse
 endif
{% endif %}
 call route-filter APPLY-CUSTOMER-LP
 apply community {{ plan.c_downstream(alvo.tipo, alvo.origem, alvo.pop) }} additive
{% if alvo.asn %}
 apply large-community {{ plan.conjunto(plan.c_large(1000, alvo.asn)) }} additive
{% endif %}
{% if chamar_apply_peer %}
 call route-filter APPLY-PEER-{{ alvo.token }}
{% endif %}
{#- o tratamento por prefixo do cadastro, do mais especifico para o menos. O
    if/elseif e o que faz um /24 escrito dentro de um /22 vencer o /22, em vez
    de os dois somarem. Depois do APPLY-PEER de proposito: o 1xx da linha
    vence o da CL-PEER, porque a ultima escrita de local-preference vence. #}
{% if tratamentos %}
 !- tratamento por prefixo do cadastro, do mais especifico para o menos
{% for prefixo, ate, communities in tratamentos %}
{% set std, lg = plan.separa_communities(communities) %}
 {{ "if" if loop.first else "elseif" }} {{ "ipv6" if fam == "v6" else "ip" }} route-destination in {{ plan.conjunto_do_prefixo(prefixo, ate) }} then
{% if std %}
  apply community {{ plan.conjunto_de(std) }} additive
{% endif %}
{% if lg %}
  apply large-community {{ plan.conjunto_de(lg) }} additive
{% endif %}
{% endfor %}
 endif
{% endif %}
{% if confinar_prefixo %}
 finish
{% else %}
 {#- sem confinamento nao ha whitelist nenhuma: o import aceitaria qualquer
     prefixo que passasse pelo sanity e o carimbaria como de cliente, que e
     rota anunciável no egress. Negar por padrao inverte isso, e e o que
     protege o membro de grupo que nao trouxe prefixo proprio - o de hoje
     todos trazem, mas o proximo so entra na internet depois de trazer. O
     `refuse` e terminal, entao nao ha `finish` depois dele. #}
 refuse
{% endif %}
end-filter
{%- endmacro %}

{% macro cabecalho_grupo(grupo) -%}
# gerado por bgpgen - nao editar a mao
# grupo {{ grupo.id }} - {{ grupo.tipo }} - nome {{ grupo.nome }}
{% if grupo.tipo in plan.TIPOS_DOWNSTREAM %}
# tabela recebida: {{ grupo.tabela }}
{% endif %}
{% if grupo.default_route %}
# default route: o VRP origina 0/0 e ::/0 nesta sessao mesmo sem default na tabela
{% endif %}
# pressupoe o bloco base ja aplicado neste equipamento
{%- endmacro %}

{% macro sessao_do_grupo(grupo) -%}
{% if grupo.asn %}
 peer {{ grupo.nome }} as-number {{ grupo.asn }}
{% endif %}
{% if grupo.timer_keepalive and grupo.timer_hold %}
 peer {{ grupo.nome }} timer keepalive {{ grupo.timer_keepalive }} hold {{ grupo.timer_hold }}
{% endif %}
{% if grupo.graceful_restart %}
 peer {{ grupo.nome }} capability-advertise graceful-restart
{% endif %}
{% if grupo.bfd %}
 peer {{ grupo.nome }} bfd enable
{% endif %}
{%- endmacro %}

{% macro familia_grupo(grupo, fam, import_nome, export_nome) -%}
{% set linha_default = "\n  peer " ~ grupo.nome ~ " default-route-advertise" if grupo.default_route else "" %}
 {{ "ipv6-family" if fam == "v6" else "ipv4-family" }} unicast
  peer {{ grupo.nome }} enable
  peer {{ grupo.nome }} {{ plan.AS_ONLY }}
  peer {{ grupo.nome }} route-filter {{ import_nome }} import
  peer {{ grupo.nome }} route-filter {{ export_nome }} export
  peer {{ grupo.nome }} advertise-community
  peer {{ grupo.nome }} advertise-large-community{{ linha_default }}
{%- endmacro %}

{% macro export_por_asn_do_membro(membro, grupo, fam) -%}
{% set U = fam|upper %}
{# O `64512:0:<asn>` recusa o anuncio ao ASN e o `1/2/3:<asn>` prependa para
   ele: os dois olham o ASN do DESTINATARIO, e num grupo sem ASN quem tem o
   ASN e o membro. O export do grupo, um so para todos, nao tem como
   avalia-los, entao o membro leva esse pedaco e chama o export do grupo pelo
   resto - a politica comum continua morando num lugar so. Num grupo com ASN
   nada disto sai: o export do grupo ja carrega os controles daquele ASN, que
   e o de todos os membros (o validar recusa membro com ASN diferente).

   O ASN sai do membro, que sempre declara o dele, e o `or grupo.asn` cobre a
   heranca. A guarda toda e para o yaml editado a mao com o ASN em branco: o
   c_large de um ASN que nao existe e TypeError no render, e ele levaria a
   pagina da config inteira junto. Sem ASN o filtro fica so com a chamada, e
   o membro herda o grupo como se nao tivesse o override. #}
{% set asn = membro.asn or grupo.asn %}
xpl route-filter CUST-{{ membro.token }}-EXPORT-{{ U }}
{% if asn %}
 if large-community matches-any {{ plan.conjunto(plan.c_large(0, asn)) }} then
  refuse
 endif
 if large-community matches-any {{ plan.conjunto(plan.c_large(3, asn)) }} then
  apply as-path {{ plan.ASN }} 3 additive
 elseif large-community matches-any {{ plan.conjunto(plan.c_large(2, asn)) }} then
  apply as-path {{ plan.ASN }} 2 additive
 elseif large-community matches-any {{ plan.conjunto(plan.c_large(1, asn)) }} then
  apply as-path {{ plan.ASN }} 1 additive
 endif
{% endif %}
{# o `finish` do filtro do grupo encerra este, e encerrar aqui e o aceite:
   nao ha nada depois da chamada de proposito. #}
 call route-filter CUST-{{ grupo.token }}-EXPORT-{{ U }}
end-filter
{%- endmacro %}

{% macro filtro_downstream_export(alvo, fam) -%}
{% set U = fam|upper %}
{# o exige_tabela para o render com valor fora da lista: o ramo sem portao e
   o da full table, e so o "full" explicito pode chegar nele #}
{% set tabela = plan.exige_tabela(alvo.tabela) %}
xpl route-filter CUST-{{ alvo.token }}-EXPORT-{{ U }}
{% if tabela == "nenhuma" %}
 {# So a default vai para esta sessao, e ela nao passa por este filtro: o VRP
    a origina por fora do export. Nao ha rota para vetar nem para prependar,
    e o filtro existe porque a sessao o referencia. #}
 refuse
{% else %}
 {# Restricao padronizada recebida: a rota nao sai do AS, e isso vale tambem
    para a entrega ao cliente, que e eBGP. Vem antes de tudo, e o egresso de
    cliente e o unico caminho que nao passa pelo EXPORT-SANITY. #}
 if community matches-any CL-RESTRICAO then
  refuse
 endif
 {# pedido de descarte nao e rota para entregar: o host autorizado ja cai no
    200 do CL-NOADV-CUST, e este veto pega o que escapar do import. #}
 if community matches-any CL-BLACKHOLE or tag eq 666 then
  refuse
 endif
 if community matches-any CL-NOADV-CUST then
  refuse
 endif
 if community matches-any CL-ONLY-NOT-CLIENT then
  refuse
 endif
{% if alvo.asn %}
 if large-community matches-any {{ plan.conjunto(plan.c_large(0, alvo.asn)) }} then
  refuse
 endif
{% endif %}
 if community matches-any {{ plan.conjunto(plan.c(1900), plan.c(1901)) }} then
  refuse
 endif
{% if tabela in ("parcial", "parcial_ix") %}
 {# A tabela parcial: so a rota propria e a de cliente, e na parcial_ix tambem
    a aprendida no IX. A rota de upstream e de PNI para aqui. Vem depois dos
    vetos, que valem em qualquer tabela, e antes do prepend, que nao tem o
    que fazer com rota recusada. #}
 if not community matches-any {{ "CL-ORIGEM-PARCIAL-IX" if tabela == "parcial_ix" else "CL-ORIGEM-ANUNCIAVEL" }} then
  refuse
 endif
{% endif %}
{% if alvo.asn %}
 if large-community matches-any {{ plan.conjunto(plan.c_large(3, alvo.asn)) }} then
  apply as-path {{ plan.ASN }} 3 additive
 elseif large-community matches-any {{ plan.conjunto(plan.c_large(2, alvo.asn)) }} then
  apply as-path {{ plan.ASN }} 2 additive
 elseif large-community matches-any {{ plan.conjunto(plan.c_large(1, alvo.asn)) }} then
  apply as-path {{ plan.ASN }} 1 additive
 endif
{% endif %}
 finish
{% endif %}
end-filter
{%- endmacro %}

{# O miolo do bloco de upstream, em macro de alvo duplo: o Peer avulso e o
   Grupo passam os dois, porque o grupo de upstream existe justamente para
   que dois links do mesmo transito nao guardem a mesma politica em dois
   lugares. So o que os dois tem pode aparecer aqui: token, id, asn, origem,
   lp_base, aprendizado, te_prefixos, ap_block, ap_te, bh_upstream e
   prepend_base. sessoes, familias(), route_limit e descricao sao do peer e
   ficam de fora - o StrictUndefined do render estoura no teste se algum
   entrar. #}
{% macro te_prefix_list(alvo, fam) -%}
{% set U = fam|upper %}
{% set kw = "ipv6-prefix-list" if fam == "v6" else "ip-prefix-list" %}
{% set maxlen = plan.TETO_PREFIXO[fam] %}
{% if alvo.te_prefixos[fam] %}
!- conteudo de EXEMPLO no PLANO: troque pelos prefixos reais antes de subir
xpl {{ kw }} PL-TE-PREFER-{{ alvo.token }}-{{ U }}
{% for cidr in alvo.te_prefixos[fam] %}
 {{ plan.cidr_para_xpl(cidr) }} le {{ maxlen }}{{ "," if not loop.last }}
{% endfor %}
end-list
{% endif %}
{%- endmacro %}

{#- O carimbo do import externo com a restricao padronizada preservada. O
    carimbo substitui a community recebida, e a restricao iria junto, entao
    ela e relida AQUI dentro do ramo que carimba - e a unica janela em que ela
    ainda existe - e volta como a marca propria do CL-RESTRICAO. O `recuo` e
    do chamador: o mesmo carimbo sai no corpo do filtro e um nivel adentro do
    ramo de GSHUT. As duas restricoes juntas nao tem problema: o `matches-any`
    do CL-RESTRICAO le as tres de uma vez e o carimbo sai uma vez so. #}
{% macro carimbo_do_import(marcas, recuo) -%}
{{ recuo }}if community matches-any CL-RESTRICAO then
{{ recuo }} apply community {{ plan.conjunto_de(marcas + [plan.RESTRICAO]) }} overwrite
{{ recuo }}else
{{ recuo }} apply community {{ plan.conjunto_de(marcas) }} overwrite
{{ recuo }}endif
{%- endmacro %}


{% macro filtro_upstream_import(alvo, fam) -%}
{% set U = fam|upper %}
xpl route-filter UP-{{ alvo.token }}-IMPORT-{{ U }}
 call route-filter IMPORT-SANITY-{{ U }}
 call route-filter REJEITA-BLOCO-PROPRIO-{{ U }}
{% if alvo.ap_block %}
 if as-path in AP-BLOCK-{{ alvo.token }} then
  refuse
 endif
{% endif %}
{# O GSHUT do vizinho (RFC 8326) e o pedido de drenagem sem derrubar a sessao.
    Ele sai num ramo proprio, ANTES do carimbo: a community so existe ate o
    overwrite, que e quem a apaga. O ramo repete o carimbo e encerra o filtro
    com LP 0 para as excecoes de TE e de prefixo proprio de baixo nao
    escreverem preferencia por cima da drenagem. O carimbo repetido nao e
    enfeite: sem ele a rota drenada fica sem classificacao, o EXPORT-SANITY a
    recusa no egress, e o que era para ser ultimo recurso vira retirada. #}
 if community matches-any CL-GSHUT then
{{ carimbo_do_import([plan.c(alvo.origem), plan.c(alvo.aprendizado), plan.c(2000)], "  ") }}
  apply large-community {{ plan.conjunto(plan.c_large(1000, alvo.asn)) }} overwrite
  apply local-preference 0
  {# finish, e nao approve: `approve` NAO encerra o processamento, so
     reencaminha para o proximo `if` (PLANO, referencia de sintaxe XPL), e as
     escritas de LP de baixo poriam 100 ou 500 por cima da drenagem. #}
  finish
 endif
 apply local-preference {{ alvo.lp_base }}
 {# overwrite: nada do que o upstream escreveu em community sobrevive. e o que
    torna seguro o matches-any CL-ORIGEM-ANUNCIAVEL no export. 2000 marca
    "aprendida de fora", e o export de outro upstream recusa. #}
{{ carimbo_do_import([plan.c(alvo.origem), plan.c(alvo.aprendizado), plan.c(2000)], " ") }}
 apply large-community {{ plan.conjunto(plan.c_large(1000, alvo.asn)) }} overwrite
{% if alvo.te_prefixos[fam] or alvo.ap_te %}
 {# excecoes de TE, aplicadas depois do carimbo base. Se a lista ficar vazia a
    excecao simplesmente nao existe; o risco e o oposto, prefixo errado faz o
    trafego sair e voltar. #}
 if{% if alvo.te_prefixos[fam] %} {{ "ipv6" if fam == "v6" else "ip" }} route-destination in PL-TE-PREFER-{{ alvo.token }}-{{ U }}{% endif %}{% if alvo.te_prefixos[fam] and alvo.ap_te %} or{% endif %}{% if alvo.ap_te %} as-path in AP-TE-PREFER-{{ alvo.token }}{% endif %} then
  apply local-preference {{ plan.LP_TE_PREFER }}
 endif
{% endif %}
{# os blocos que o proprio upstream origina: a rota que vem dele e o melhor
   caminho para esses prefixos. Vem DEPOIS do TE de proposito. As duas
   clausulas escrevem local-preference, e a ultima vence; o prefixo do
   proprio upstream costuma estar tambem na lista de excecao de TE, que e
   de "prefixos alcancados melhor pela borda dele". Antes do TE, o 250
   passaria por cima do 500 exatamente onde a preferencia existe para
   marcar. #}
 if as-path in AP-OWN-{{ alvo.token }} then
  apply local-preference {{ plan.LP_PREFIXO_DO_PEER }}
 endif
 approve
end-filter
{%- endmacro %}

{% macro filtro_upstream_export(alvo, fam, chamar_apply_peer) -%}
{% set U = fam|upper %}
xpl route-filter UP-{{ alvo.token }}-EXPORT-{{ U }}
 {# 1. blackhole primeiro: finish para nao cair no EXPORT-SANITY. O overwrite
    aqui nao e limpeza: e a definicao do anuncio de blackhole. Durante ataque
    o host sai com a community de blackhole deste upstream e nada mais, para
    que nenhuma community escrita pelo cliente a neutralize. #}
 if (community matches-any CL-BLACKHOLE or tag eq 666) and {{ "ipv6" if fam == "v6" else "ip" }} route-destination in {{ "{0.0.0.0 0 ge 32 le 32}" if fam == "v4" else "{:: 0 ge 128 le 128}" }} then
  if community matches-any CL-BLACKHOLE-PROPAGATE then
   {# O pedido de propagacao nao atropela o bloqueio do proprio destino nem o
      escopo: este ramo termina em finish, entao as duas checagens precisam
      estar aqui dentro, e nao la embaixo. O 200 fica de fora de proposito -
      ele e a marca que todo blackhole importado carrega, e bani-lo aqui
      mataria a propagacao inteira. #}
   if community matches-any {{ plan.conjunto(*plan.bloqueio_do_destino("upstream", alvo.id)) }} or large-community matches-any {{ plan.conjunto(plan.c_large(0, alvo.asn)) }} then
    refuse
   endif
   if community matches-any CL-ONLY-NOT-UP then
    refuse
   endif
   {# e a restricao padronizada vale aqui tambem: o ramo termina em finish, e
      o EXPORT-SANITY de baixo nao chega a ver esta rota. #}
   if community matches-any CL-RESTRICAO then
    refuse
   endif
{% if alvo.bh_upstream %}
   apply community {{ plan.conjunto(alvo.bh_upstream) }} overwrite
{% endif %}
   finish
  else
   refuse
  endif
 endif
 {# 2. sanidade antes de liberar a rota #}
 call route-filter EXPORT-SANITY
 {# 3. rede de seguranca do 2000: rota aprendida de fora ja caiu acima, entao
    isto so alcanca rota de cliente que escreveu o 2000 sozinha. #}
 if community matches-any {{ plan.conjunto(plan.c(2000)) }} then
  refuse
 endif
 {# 4. escopo pedido pelo cliente para este peer #}
 if community matches-any CL-NOADV-{{ alvo.token }} or large-community matches-any LC-NOADV-{{ alvo.token }} then
  refuse
 endif
 {# 5. somente para outro peer #}
 if community matches-any CL-ONLY-NOT-UP then
  refuse
 endif
 {# 6. 5PPA por peer especifico: P4=3x, P3=2x, P2=1x. Se veio QUALQUER 5PPA do
    peer, a classe 6CA nao entra: especifico vence generico. O P1 explicito so
    impede a classe, e por isso o aninhamento e if/elseif e nao finish, que
    saltaria os passos 8 e 9. #}
 if community matches-any CL-5PPA-{{ "%02d"|format(alvo.id) }} or large-community matches-any LC-5PPA-{{ alvo.token }} then
  if community matches-any {{ plan.conjunto(plan.c5ppa(alvo.id, 4)) }} or large-community matches-any LC-PREP3-{{ alvo.token }} then
   apply as-path {{ plan.ASN }} 3 additive
  elseif community matches-any {{ plan.conjunto(plan.c5ppa(alvo.id, 3)) }} or large-community matches-any LC-PREP2-{{ alvo.token }} then
   apply as-path {{ plan.ASN }} 2 additive
  elseif community matches-any {{ plan.conjunto(plan.c5ppa(alvo.id, 2)) }} or large-community matches-any LC-PREP1-{{ alvo.token }} then
   apply as-path {{ plan.ASN }} 1 additive
  endif
 else
  {# 7. sem 5PPA, vale a classe 6CA (plan.CLASSE_6CA["upstream"] = upstream) #}
  if community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["upstream"], 4)) }} then
   apply as-path {{ plan.ASN }} 3 additive
  elseif community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["upstream"], 3)) }} then
   apply as-path {{ plan.ASN }} 2 additive
  elseif community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["upstream"], 2)) }} then
   apply as-path {{ plan.ASN }} 1 additive
  endif
 endif
{% if alvo.prepend_base %}
 {# 8. prepend base de engenharia: o valor JA E o numero de prepends, entao a
    linha nao sai quando ele e zero. #}
 apply as-path {{ plan.ASN }} {{ alvo.prepend_base }} additive
{% endif %}
 {# 9. saida comum #}
 apply med 0
{# chamar_apply_peer=false e o sinal do grupo de downstream
   (grupo_cliente.txt.j2): ali a community descreve o LINK, cada membro tem a
   sua, e o APPLY-PEER e por sessao, nunca do grupo. Num upstream e o
   contrario - a community descreve a REDE REMOTA, um objeto so vale para os
   dois links, e o grupo passa true, porque e o export dele que chama o
   APPLY-PEER-<G> (grupo_upstream.txt.j2). #}
{% if chamar_apply_peer %}
 {# ULTIMA acao: as communities do cadastro deste upstream, para tudo que sai
    por ele. O quadro "ao criar" - do peer avulso ou do grupo de upstream,
    os dois alvos de criar_lista.txt.j2 - traz o conteudo da lista; aqui so a
    chamada. #}
 call route-filter APPLY-PEER-{{ alvo.token }}
{% endif %}
 finish
end-filter
{%- endmacro %}

{% macro listas_upstream(alvo) %}
{#- o branco abaixo e de proposito, e o newline da chamada no template e o da
    ultima linha do EXPORT: sem ele a linha em branco que separa o ultimo
    filtro da primeira lista some. #}

{# um set por peer: evita cadeia de OR na condicao. o 5xx aqui e o alias 5PPA
   do "nao anunciar para o peer". #}
xpl community-list CL-NOADV-{{ alvo.token }}
{% for c in plan.noadv("upstream", alvo.id) %}
 {{ c }}{{ "," if not loop.last }}
{% endfor %}
end-list

xpl large-community-list LC-NOADV-{{ alvo.token }}
 {{ plan.c_large(0, alvo.asn) }}
end-list

{# qualquer 5PPA do peer, inclusive o digito 0. Nao carrega acao: serve para o
   egress saber que o cliente falou deste peer e para barrar a classe 6CA, que
   perderia para o especifico. #}
xpl community-list CL-5PPA-{{ "%02d"|format(alvo.id) }}
{% for d in range(5) %}
 {{ plan.c5ppa(alvo.id, d) }}{{ "," if not loop.last }}
{% endfor %}
end-list

{# espelho do CL-5PPA no eixo de 32 bits. #}
xpl large-community-list LC-5PPA-{{ alvo.token }}
{% for f in range(5) %}
 {{ plan.c_large(f, alvo.asn) }}{{ "," if not loop.last }}
{% endfor %}
end-list

xpl large-community-list LC-PREP1-{{ alvo.token }}
 {{ plan.c_large(1, alvo.asn) }}
end-list

xpl large-community-list LC-PREP2-{{ alvo.token }}
 {{ plan.c_large(2, alvo.asn) }}
end-list

xpl large-community-list LC-PREP3-{{ alvo.token }}
 {{ plan.c_large(3, alvo.asn) }}
end-list
{%- if alvo.ap_block %}
{#- o - deste if come o newline da lista de cima, e o {{ "\n" }} abaixo repoe
    o branco de separacao. Os dois sao o ajuste de espaco da emenda: sem eles a
    ULTIMA lista emitida levaria um newline proprio para a emenda com o
    APPLY-PEER, que o template ja abre com uma linha em branco. #}
{{ "\n" }}
{# PLANO.md / AS-path por peer. Fora do laco de familia: a lista nao tem eixo
   de familia, e num peer dual-stack ela sairia definida duas vezes. Sem block
   list a excecao nao existe, e o import ja so consulta esta lista quando ela
   tem conteudo: a definicao segue a referencia. #}
xpl as-path-list AP-BLOCK-{{ alvo.token }}
{% for asn in alvo.ap_block %}
 pass '{{ asn }}'{{ "," if not loop.last }}
{% endfor %}
end-list
{%- endif %}
{%- if alvo.ap_te %}
{{ "\n" }}
{# ASNs que se alcanca melhor pela borda deste upstream. origin, como no
   PLANO: o que interessa e quem originou, nao por onde passou. #}
xpl as-path-list AP-TE-PREFER-{{ alvo.token }}
{% for asn in alvo.ap_te %}
 origin '{{ asn }}'{{ "," if not loop.last }}
{% endfor %}
end-list
{%- endif %}
{{ "\n" }}
{# Os blocos do proprio upstream. origin e nao pass pelo mesmo motivo do
   AP-CUST e do AP-TE-PREFER: o peer pode prependar o bloco dele, e o path
   sai "14840 14840" - com pass a rota prependada deixaria de casar e a
   preferencia sumiria sem aviso. A lista e incondicional porque a
   preferencia vale para todo upstream; so o IX e o PNI nao a tem, e la o
   bloco do peer nao e melhor caminho para nada. #}
xpl as-path-list AP-OWN-{{ alvo.token }}
 origin '{{ alvo.asn }}'
end-list
{%- endmacro %}

{# O miolo do IX. Tudo do IX sem eixo de familia cabe em listas_ix: nem o
   AP-IX nem os CL/LC-NOADV mudam com a familia. #}
{% macro filtro_ix_import(alvo, fam) -%}
{% set U = fam|upper %}
xpl route-filter IX-{{ alvo.token }}-IMPORT-{{ U }}
 call route-filter IMPORT-SANITY-{{ U }}
 call route-filter REJEITA-BLOCO-PROPRIO-{{ U }}

{# O limite `as-path length ge 4` saiu daqui: comprimento de path mede
   tamanho, nao autorizacao, e a regra recusava cone legitimo e prepend de
   membro anunciando para o IX inteiro. Quem autoriza no IX e o
   IMPORT-SANITY, com o AP-LOCAL-ORIGIN, mais o confinamento de origem. #}
{# O GSHUT do membro (RFC 8326) e o pedido de drenagem sem derrubar a sessao.
   Ele sai num ramo proprio, ANTES do carimbo: a community so existe ate o
   overwrite, que e quem a apaga. O ramo repete o carimbo e encerra o filtro
   com LP 0 para o LP do CDN preferido de baixo nao passar por cima da
   drenagem. Sem o carimbo repetido a rota drenada fica sem classificacao e o
   EXPORT-SANITY a recusa no egress, virando retirada em vez de ultimo
   recurso. #}
 if community matches-any CL-GSHUT then
{{ carimbo_do_import([plan.c(alvo.origem), plan.c(alvo.aprendizado), plan.c(2000)], "  ") }}
  apply large-community {{ plan.conjunto(plan.c_large(1001, alvo.ix_id)) }} overwrite
  apply local-preference 0
  finish
 endif

 {# overwrite: nada do que o membro do IX escreveu sobrevive. 1001:<ix_id> e a
    informativa de IX; o id e o do PeeringDB, nao o ASN do route server. #}
{{ carimbo_do_import([plan.c(alvo.origem), plan.c(alvo.aprendizado), plan.c(2000)], " ") }}
 apply large-community {{ plan.conjunto(plan.c_large(1001, alvo.ix_id)) }} overwrite

{% if alvo.ap_prefer %}
 if as-path in AP-IX-{{ alvo.token }} then
  apply local-preference {{ plan.LP_IX_CDN }}
 else
  apply local-preference {{ alvo.lp_base }}
 endif
{% else %}
 apply local-preference {{ alvo.lp_base }}
{% endif %}

 finish
 end-filter
{%- endmacro %}

{% macro filtro_ix_export(alvo, fam) -%}
{% set U = fam|upper %}
xpl route-filter IX-{{ alvo.token }}-EXPORT-{{ U }}
 call route-filter EXPORT-SANITY

 {# rede de seguranca do 2000, igual ao egress de upstream: rota aprendida de
    fora ja caiu no EXPORT-SANITY acima. #}
 if community matches-any {{ plan.conjunto(plan.c(2000)) }} then
  refuse
 endif

 if community matches-any CL-NOADV-{{ alvo.token }} or large-community matches-any LC-NOADV-{{ alvo.token }} then
  refuse
 endif

 if community matches-any CL-ONLY-NOT-IX then
  refuse
 endif

 {# 6CA da classe plan.CLASSE_6CA["ix"] = IX publico; P2=1x, P3=2x, P4=3x. Sem
    ramo 5PPA: o route server repassa o mesmo AS-path a todos os membros,
    entao prepend no egress da sessao com o RS prependa para todo mundo.
    Prepend por membro so com sessao bilateral. #}
 if community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["ix"], 4)) }} then
  apply as-path {{ plan.ASN }} 3 additive
 elseif community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["ix"], 3)) }} then
  apply as-path {{ plan.ASN }} 2 additive
 elseif community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["ix"], 2)) }} then
  apply as-path {{ plan.ASN }} 1 additive
 endif

 {# sem limpeza no fecho: a rota sai com tudo o que carrega, e o que decide o
    anuncio sao os matches-any acima. #}
 finish
 end-filter
{%- endmacro %}

{% macro listas_ix(alvo) %}
{#- o branco abaixo e de proposito, e o newline da chamada no template e o da
    ultima linha do EXPORT: sem ele a linha em branco que separa o ultimo
    filtro da primeira lista some. #}

{# um set por peer: evita cadeia de OR na condicao. #}
xpl community-list CL-NOADV-{{ alvo.token }}
{% for c in plan.noadv("ix", alvo.id) %}
 {{ c }}{{ "," if not loop.last }}
{% endfor %}
 end-list

xpl large-community-list LC-NOADV-{{ alvo.token }}
 {{ plan.c_large(0, alvo.asn) }}
 end-list
{%- if alvo.ap_prefer %}
{#- o - deste if come o newline da lista de cima, e o {{ "\n" }} abaixo repoe
    o branco de separacao. O branco fica no comeco do bloco opcional, e nao no
    fim: senao a ULTIMA lista emitida levaria um newline proprio para a emenda
    com o bgp, que o template ja abre com uma linha em branco. #}
{{ "\n" }}
{# membros deste IX que recebem LP plan.LP_IX_CDN em vez de alvo.lp_base.
   peer-is, nao pass: o route server e transparente e nao insere o proprio
   ASN no path, entao peer-is identifica quem realmente anunciou, e da
   politica por membro com uma unica sessao contra o RS. #}
xpl as-path-list AP-IX-{{ alvo.token }}
{% for asn in alvo.ap_prefer %}
 peer-is '{{ asn }}'{{ "," if not loop.last }}
{% endfor %}
 end-list
{%- endif %}
{%- endmacro %}

{# O miolo do PNI. #}
{% macro filtro_pni_import(alvo, fam) -%}
{% set U = fam|upper %}
xpl route-filter PNI-{{ alvo.token }}-IMPORT-{{ U }}
 call route-filter IMPORT-SANITY-{{ U }}
 call route-filter REJEITA-BLOCO-PROPRIO-{{ U }}

 {# sessao bilateral: so entra o que a CDN pode anunciar #}
 if not as-path in AP-{{ alvo.token }}-ALLOWED then
  refuse
 endif

{# O GSHUT da CDN (RFC 8326) e o pedido de drenagem sem derrubar a sessao. Ele
   sai num ramo proprio, ANTES do carimbo: a community so existe ate o
   overwrite, que e quem a apaga. O ramo repete o carimbo e encerra o filtro
   com LP 0 para o lp_base de baixo nao passar por cima da drenagem. Sem o
   carimbo repetido a rota drenada fica sem classificacao e o EXPORT-SANITY a
   recusa no egress, virando retirada em vez de ultimo recurso. #}
 if community matches-any CL-GSHUT then
{{ carimbo_do_import([plan.c(alvo.origem), plan.c(plan.GEO_PNI), plan.c(2000)], "  ") }}
  apply large-community {{ plan.conjunto(plan.c_large(1000, alvo.asn)) }} overwrite
  apply local-preference 0
  finish
 endif

 apply local-preference {{ alvo.lp_base }}
 {# overwrite: a CDN nao escreve no nosso namespace. plan.GEO_PNI e a
    geografia fixa do PNI. 2000 porque a rota vem de fora: nao e propria nem
    de cliente. #}
{{ carimbo_do_import([plan.c(alvo.origem), plan.c(plan.GEO_PNI), plan.c(2000)], " ") }}
 apply large-community {{ plan.conjunto(plan.c_large(1000, alvo.asn)) }} overwrite

 finish
 end-filter
{%- endmacro %}

{% macro filtro_pni_export(alvo, fam) -%}
{% set U = fam|upper %}
xpl route-filter PNI-{{ alvo.token }}-EXPORT-{{ U }}
 call route-filter EXPORT-SANITY

 {# rede de seguranca do 2000, igual aos demais egress externos. #}
 if community matches-any {{ plan.conjunto(plan.c(2000)) }} then
  refuse
 endif

 if community matches-any CL-NOADV-{{ alvo.token }} or large-community matches-any LC-NOADV-{{ alvo.token }} then
  refuse
 endif

 if community matches-any CL-ONLY-NOT-PNI then
  refuse
 endif

 {# 6CA da classe plan.CLASSE_6CA["pni"] = CDN; P2=1x, P3=2x, P4=3x. O PNI e
    bilateral e o ramo 5PPA funcionaria aqui, mas o exemplo do PLANO nao o
    traz; fica na lista de pendencias, nao como decisao. #}
 if community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["pni"], 4)) }} then
  apply as-path {{ plan.ASN }} 3 additive
 elseif community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["pni"], 3)) }} then
  apply as-path {{ plan.ASN }} 2 additive
 elseif community matches-any {{ plan.conjunto(plan.c6ca(plan.CLASSE_6CA["pni"], 2)) }} then
  apply as-path {{ plan.ASN }} 1 additive
 endif

 {# igual ao egress do IX: sem limpeza no fecho. A CDN nao tem community
    propria hoje; se tiver, entra a mesma montagem de APPLY-PEER-<T> usada no
    upstream. #}
 finish
 end-filter
{%- endmacro %}

{% macro listas_pni(alvo) %}
{#- o branco abaixo e de proposito, e o newline da chamada no template e o da
    ultima linha do EXPORT: sem ele a linha em branco que separa o ultimo
    filtro da primeira lista some. #}

{# CDN via PNI: so estes ASNs podem chegar por esta sessao. pass, nao origin:
   o que se quer e aceitar path que passe pelo ASN da CDN, que costuma
   anunciar por tras do transito dela. #}
xpl as-path-list AP-{{ alvo.token }}-ALLOWED
{% for asn in alvo.ap_allowed %}
 pass '{{ asn }}'{{ "," if not loop.last }}
{% endfor %}
 end-list

{# um set por peer: evita cadeia de OR na condicao. #}
xpl community-list CL-NOADV-{{ alvo.token }}
{% for c in plan.noadv("pni", alvo.id) %}
 {{ c }}{{ "," if not loop.last }}
{% endfor %}
 end-list

xpl large-community-list LC-NOADV-{{ alvo.token }}
 {{ plan.c_large(0, alvo.asn) }}
 end-list
{%- endmacro %}

{# O peer que reaproveita a politica de outro: so a sessao, apontando para
   os filtros da origem. Nenhum objeto xpl - e essa a diferenca para o peer
   avulso, que define o par inteiro com o proprio token no nome.

   A sessao sai inteira e com os valores deste peer, e nao os da origem:
   aqui nao ha grupo do VRP carregando timers, bfd e advertise-community,
   entao o bloco de quem reaproveita tem que trazer o que o peer avulso
   traz. O que muda de dono e so a politica. #}
{% macro bloco_reaproveita(alvo, origem) -%}
bgp {{ plan.ASN }}
{% for fam in alvo.familias() %}
{{ sessao_do_peer(alvo, fam) }}{{ "\n" if not loop.last -}}
{% endfor %}
{% for fam in alvo.familias() %}
{% set U = fam|upper %}
{% set P = plan.PREFIXO_DO_TIPO[alvo.tipo] %}
{{ familia_bgp(alvo, fam,
     P ~ "-" ~ origem.token ~ "-IMPORT-" ~ U,
     P ~ "-" ~ origem.token ~ "-EXPORT-" ~ U) }}
{% endfor %}
{%- endmacro %}
